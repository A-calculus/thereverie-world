{
  "uiSlug": "global-climate-crisis-response",
  "displayName": "Global Climate Crisis Response",
  "description": "A lightweight planetary weather-response world that checks public weather JSON, updates regional zones and agency factions, and writes verifiable crisis records.",
  "version": "climate-crisis-response-v1",
  "engine": "genericEventWorld",
  "publicTypes": {
    "ClimateSeverity": [
      "STABLE",
      "WATCH",
      "WARNING",
      "EMERGENCY"
    ],
    "inputs": [
      "regionId",
      "severityThreshold",
      "drillScenario"
    ]
  },
  "inputSchema": [
    {
      "id": "regionId",
      "label": "Region",
      "type": "select",
      "required": true,
      "defaultValue": "europe",
      "options": [
        {
          "label": "Americas Zone",
          "value": "americas"
        },
        {
          "label": "Europe Zone",
          "value": "europe"
        },
        {
          "label": "Asia-Pacific Zone",
          "value": "asia-pacific"
        },
        {
          "label": "Africa / Middle East Zone",
          "value": "africa-middle-east"
        }
      ]
    },
    {
      "id": "severityThreshold",
      "label": "Severity threshold",
      "type": "number",
      "required": true,
      "defaultValue": 2
    },
    {
      "id": "drillScenario",
      "label": "Manual drill scenario",
      "type": "text",
      "required": true,
      "defaultValue": "Heavy rain and wind threaten transport corridors near London."
    }
  ],
  "dataSources": [
    {
      "id": "openMeteoEurope",
      "name": "Open-Meteo Weather Sample",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=51.5072&longitude=-0.1276&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    }
  ],
  "agentChain": [
    {
      "id": "weather-reader",
      "name": "Weather Reader Agent",
      "agentType": "native_json_api",
      "purpose": "Read current weather JSON and surface temperature, wind, precipitation, and weather code.",
      "inputTemplate": "Inspect weather data for {{runtime.inputs.regionId}}. Raw source: {{source.value}}.",
      "persistResult": false
    },
    {
      "id": "severity-assessor",
      "name": "Severity Assessment Agent",
      "agentType": "native_llm",
      "purpose": "Classify regional crisis severity as STABLE, WATCH, WARNING, or EMERGENCY.",
      "inputTemplate": "Assess crisis severity for {{runtime.inputs.regionId}} using threshold {{runtime.inputs.severityThreshold}} and previous output {{previous.output}}.",
      "persistResult": false
    },
    {
      "id": "zone-climate-update",
      "name": "Zone Climate Agent",
      "agentType": "reverie_custom",
      "purpose": "Update the selected region state with the current crisis level.",
      "inputTemplate": "Update zone climate for {{runtime.inputs.regionId}} from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "agency-readiness",
      "name": "Agency Readiness Agent",
      "agentType": "native_llm",
      "purpose": "Update response faction readiness and coordination posture.",
      "inputTemplate": "Map the crisis assessment into readiness changes for government, NGO, private sector, and insurance factions.",
      "persistResult": true
    },
    {
      "id": "crisis-chronicle",
      "name": "Crisis Chronicle Agent",
      "agentType": "reverie_custom",
      "purpose": "Write the public crisis record with evidence and receipt context.",
      "inputTemplate": "Write a concise Chronicle entry for the crisis assessment: {{previous.output}}.",
      "persistResult": true
    }
  ],
  "zones": [
    {
      "id": "americas",
      "name": "Americas Zone",
      "description": "Hurricane, tornado, flood, and heat risks across major western hemisphere cities.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "government",
        "climate": "STABLE"
      },
      "allocationPercent": 25
    },
    {
      "id": "europe",
      "name": "Europe Zone",
      "description": "Flood, heat wave, winter storm, and transport disruption risks.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "ngo",
        "climate": "STABLE"
      },
      "allocationPercent": 25
    },
    {
      "id": "asia-pacific",
      "name": "Asia-Pacific Zone",
      "description": "Typhoon, monsoon, extreme rain, and coastal infrastructure risks.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "private-sector",
        "climate": "STABLE"
      },
      "allocationPercent": 25
    },
    {
      "id": "africa-middle-east",
      "name": "Africa / Middle East Zone",
      "description": "Drought, extreme heat, dust storm, and flood risks.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "insurance",
        "climate": "STABLE"
      },
      "allocationPercent": 25
    }
  ],
  "factions": [
    {
      "id": "government",
      "name": "Government Faction",
      "description": "Large resources with slower mobilization.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Government Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "ngo",
      "name": "NGO Faction",
      "description": "Fast response with limited capacity.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "NGO Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "private-sector",
      "name": "Private Sector Faction",
      "description": "Logistics, equipment, and business continuity capacity.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Private Sector Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "insurance",
      "name": "Insurance Faction",
      "description": "Evidence review and ledger recommendation faction.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Insurance Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    }
  ],
  "triggers": [
    {
      "id": "start-climate-runtime",
      "name": "Start Climate Monitoring Runtime",
      "type": "data_condition",
      "sourceId": "openMeteoEurope",
      "condition": {
        "isStartTrigger": true
      },
      "sourceConfig": {
        "kind": "builder_input",
        "sourceId": "regionId",
        "path": ""
      },
      "typeConfig": {
        "conditionEnabled": false,
        "operator": "exists",
        "compareValue": ""
      },
      "inputParser": "{\n  \"regionId\": \"{{runtime.inputs.regionId}}\",\n  \"severityThreshold\": \"{{runtime.inputs.severityThreshold}}\",\n  \"source\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Crisis event log",
          "path": "eventLog",
          "valueTemplate": "Start Climate Monitoring Runtime completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "americas",
          "path": "latestDecision",
          "valueTemplate": "Start Climate Monitoring Runtime updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "government",
          "path": "latestDecision",
          "valueTemplate": "Start Climate Monitoring Runtime updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "crisisReadinessSummary",
          "valueTemplate": "Start Climate Monitoring Runtime completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "weather-reader",
        "severity-assessor",
        "zone-climate-update",
        "agency-readiness",
        "crisis-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "manual-crisis-drill",
      "name": "Manual Crisis Drill",
      "type": "manual_action",
      "sourceId": "openMeteoEurope",
      "sourceConfig": {
        "kind": "manual_payload",
        "path": ""
      },
      "typeConfig": {
        "buttonLabel": "Run Crisis Drill",
        "description": "Run a prepared weather crisis response drill.",
        "payloadTemplate": "{\n  \"scenario\": \"{{runtime.inputs.drillScenario}}\",\n  \"regionId\": \"{{runtime.inputs.regionId}}\"\n}"
      },
      "inputParser": "{\n  \"scenario\": \"{{runtime.inputs.drillScenario}}\",\n  \"payload\": \"{{trigger.payload}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Crisis event log",
          "path": "eventLog",
          "valueTemplate": "Manual Crisis Drill completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "europe",
          "path": "latestDecision",
          "valueTemplate": "Manual Crisis Drill updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "ngo",
          "path": "latestDecision",
          "valueTemplate": "Manual Crisis Drill updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "crisisReadinessSummary",
          "valueTemplate": "Manual Crisis Drill completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "severity-assessor",
        "zone-climate-update",
        "agency-readiness",
        "crisis-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "scheduled-weather-check",
      "name": "Scheduled Weather Check",
      "type": "scheduled",
      "sourceId": "openMeteoEurope",
      "sourceConfig": {
        "kind": "data_source",
        "sourceId": "openMeteoEurope",
        "path": "body.current"
      },
      "typeConfig": {
        "cronExpression": "*/30 * * * *",
        "timezone": "UTC"
      },
      "inputParser": "{\n  \"regionId\": \"{{runtime.inputs.regionId}}\",\n  \"weather\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Crisis event log",
          "path": "eventLog",
          "valueTemplate": "Scheduled Weather Check completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "asia-pacific",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Weather Check updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "insurance",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Weather Check updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "crisisReadinessSummary",
          "valueTemplate": "Scheduled Weather Check completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "weather-reader",
        "severity-assessor",
        "agency-readiness",
        "crisis-chronicle"
      ],
      "isActive": true
    }
  ],
  "manualActions": [
    {
      "id": "run-crisis-drill",
      "label": "Run Crisis Drill",
      "description": "Run the configured crisis drill scenario.",
      "triggerId": "manual-crisis-drill",
      "ownerOnly": true
