{
  "uiSlug": "sports-prediction-league",
  "displayName": "Sports Prediction League",
  "description": "A lightweight prediction world that locks pre-match AI predictions, settles prepared match results, updates team morale, and records outcomes with receipts.",
  "version": "sports-prediction-league-v1",
  "engine": "genericEventWorld",
  "publicTypes": {
    "PredictionState": [
      "PENDING",
      "LOCKED",
      "SETTLED",
      "DISPUTED"
    ],
    "inputs": [
      "leagueId",
      "matchId",
      "userPrediction",
      "disputeReason"
    ]
  },
  "inputSchema": [
    {
      "id": "leagueId",
      "label": "League",
      "type": "select",
      "required": true,
      "defaultValue": "premier-league",
      "options": [
        {
          "label": "Premier League",
          "value": "premier-league"
        },
        {
          "label": "NBA",
          "value": "nba"
        },
        {
          "label": "NFL",
          "value": "nfl"
        },
        {
          "label": "International Competitions",
          "value": "international"
        }
      ]
    },
    {
      "id": "matchId",
      "label": "Match",
      "type": "select",
      "required": true,
      "defaultValue": "arsenal-chelsea-demo",
      "options": [
        {
          "label": "Arsenal vs Chelsea",
          "value": "arsenal-chelsea-demo"
        },
        {
          "label": "Lakers vs Celtics",
          "value": "lakers-celtics-demo"
        },
        {
          "label": "Chiefs vs Ravens",
          "value": "chiefs-ravens-demo"
        }
      ]
    },
    {
      "id": "userPrediction",
      "label": "User prediction",
      "type": "text",
      "required": true,
      "defaultValue": "Arsenal win by one goal after a close second half."
    },
    {
      "id": "disputeReason",
      "label": "Dispute reason",
      "type": "text",
      "required": false,
      "defaultValue": "Review whether the final result was settled against the locked prediction."
    }
  ],
  "dataSources": [
    {
      "id": "demoMatchFeed",
      "name": "Prepared Match Feed",
      "type": "json",
      "url": "/api/demo/sports-prediction/matches?matchId={{runtime.inputs.matchId}}",
      "method": "GET"
    }
  ],
  "agentChain": [
    {
      "id": "match-data-reader",
      "name": "Match Data Reader",
      "agentType": "native_json_api",
      "purpose": "Read prepared match stats, kickoff state, and final result data.",
      "inputTemplate": "Inspect match data for {{runtime.inputs.matchId}} from {{source.value}}.",
      "persistResult": false
    },
    {
      "id": "prediction-locker",
      "name": "Prediction Lock Agent",
      "agentType": "native_llm",
      "purpose": "Create or evaluate a timestamped prediction before settlement.",
      "inputTemplate": "Lock a prediction for {{runtime.inputs.matchId}} using user prediction {{runtime.inputs.userPrediction}} and previous output {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "settlement-analyst",
      "name": "Settlement Analyst",
      "agentType": "native_llm",
      "purpose": "Compare locked prediction against final score and classify accuracy.",
      "inputTemplate": "Settle the prediction using match data and previous output {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "team-morale",
      "name": "Team Morale Agent",
      "agentType": "native_llm",
      "purpose": "Update team and prediction faction morale after result settlement.",
      "inputTemplate": "Update morale and reputation from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "sports-chronicle",
      "name": "Sports Chronicle Agent",
      "agentType": "reverie_custom",
      "purpose": "Write pre-match prediction and post-match settlement entries.",
      "inputTemplate": "Write a concise prediction league Chronicle entry for {{previous.output}}.",
      "persistResult": true
    }
  ],
  "zones": [
    {
      "id": "premier-league",
      "name": "Premier League Zone",
      "description": "Football clubs and table-pressure dynamics.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "home-team",
        "climate": "CALM",
        "predictionState": "PENDING"
      },
      "allocationPercent": 25
    },
    {
      "id": "nba",
      "name": "NBA Zone",
      "description": "Basketball matchup and playoff race dynamics.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "away-team",
        "climate": "CALM",
        "predictionState": "PENDING"
      },
      "allocationPercent": 25
    },
    {
      "id": "nfl",
      "name": "NFL Zone",
      "description": "Weekly matchup dynamics.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "prediction-pool",
        "climate": "CALM",
        "predictionState": "PENDING"
      },
      "allocationPercent": 25
    },
    {
      "id": "international",
      "name": "International Competitions Zone",
      "description": "Tournament matches and temporary factions.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "dispute-court",
        "climate": "CALM",
        "predictionState": "PENDING"
      },
      "allocationPercent": 25
    }
  ],
  "factions": [
    {
      "id": "home-team",
      "name": "Home Team Faction",
      "description": "Home-team morale and prediction accuracy.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Home Team Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "away-team",
      "name": "Away Team Faction",
      "description": "Away-team morale and prediction accuracy.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Away Team Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "prediction-pool",
      "name": "Prediction Pool Faction",
      "description": "Community prediction confidence and reputation.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Prediction Pool Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "dispute-court",
      "name": "Dispute Court Faction",
      "description": "Reviews disputed prediction settlements.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Dispute Court Faction is initialized from the template manifest."
      },
      "allocationPercent": 25
    }
  ],
  "triggers": [
    {
      "id": "start-sports-runtime",
      "name": "Start Prediction Runtime",
      "type": "data_condition",
      "sourceId": "demoMatchFeed",
      "condition": {
        "isStartTrigger": true
      },
      "sourceConfig": {
        "kind": "builder_input",
        "sourceId": "matchId",
        "path": ""
      },
      "typeConfig": {
        "conditionEnabled": false,
        "operator": "exists",
        "compareValue": ""
      },
      "inputParser": "{\n  \"leagueId\": \"{{runtime.inputs.leagueId}}\",\n  \"matchId\": \"{{runtime.inputs.matchId}}\",\n  \"prediction\": \"{{runtime.inputs.userPrediction}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "League event log",
          "path": "eventLog",
          "valueTemplate": "Start Prediction Runtime completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "premier-league",
          "path": "latestDecision",
          "valueTemplate": "Start Prediction Runtime updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "prediction-pool",
          "path": "latestDecision",
          "valueTemplate": "Start Prediction Runtime updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "settlementSummary",
          "valueTemplate": "Start Prediction Runtime completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "match-data-reader",
        "prediction-locker",
        "sports-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "manual-match-settlement",
      "name": "Manual Match Settlement",
      "type": "manual_action",
      "sourceId": "demoMatchFeed",
      "sourceConfig": {
        "kind": "manual_payload",
        "path": ""
      },
      "typeConfig": {
        "buttonLabel": "Settle Match",
        "description": "Settle the prepared match result against the locked prediction.",
        "payloadTemplate": "{\n  \"matchId\": \"{{runtime.inputs.matchId}}\",\n  \"prediction\": \"{{runtime.inputs.userPrediction}}\"\n}"
      },
      "inputParser": "{\n  \"matchId\": \"{{runtime.inputs.matchId}}\",\n  \"payload\": \"{{trigger.payload}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "League event log",
          "path": "eventLog",
          "valueTemplate": "Manual Match Settlement completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "nba",
          "path": "latestDecision",
          "valueTemplate": "Manual Match Settlement updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "home-team",
          "path": "latestDecision",
          "valueTemplate": "Manual Match Settlement updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "settlementSummary",
          "valueTemplate": "Manual Match Settlement completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "match-data-reader",
        "settlement-analyst",
        "team-morale",
        "sports-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "manual-dispute-review",
      "name": "Manual Dispute Review",
      "type": "manual_action",
      "sourceId": "demoMatchFeed",
      "sourceConfig": {
        "kind": "manual_payload",
        "path": ""
      },
      "typeConfig": {
        "buttonLabel": "Review Dispute",
        "description": "Review a disputed settlement with the prepared match result.",
        "payloadTemplate": "{\n  \"matchId\": \"{{runtime.inputs.matchId}}\",\n  \"reason\": \"{{runtime.inputs.disputeReason}}\"\n}"
      },
      "inputParser": "{\n  \"reason\": \"{{runtime.inputs.disputeReason}}\",\n  \"payload\": \"{{trigger.payload}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "League event log",
          "path": "eventLog",
          "valueTemplate": "Manual Dispute Review completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "nfl",
          "path": "latestDecision",
          "valueTemplate": "Manual Dispute Review updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "dispute-court",
          "path": "latestDecision",
          "valueTemplate": "Manual Dispute Review updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "settlementSummary",
          "valueTemplate": "Manual Dispute Review completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "settlement-analyst",
        "sports-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "scheduled-match-feed-check",
      "name": "Scheduled Match Feed Check",
      "type": "scheduled",
      "sourceId": "demoMatchFeed",
      "sourceConfig": {
        "kind": "data_source",
        "sourceId": "demoMatchFeed",
        "path": "body.match"
      },
      "typeConfig": {
        "cronExpression": "*/20 * * * *",
        "timezone": "UTC"
      },
      "inputParser": "{\n  \"matchId\": \"{{runtime.inputs.matchId}}\",\n  \"match\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "League event log",
          "path": "eventLog",
          "valueTemplate": "Scheduled Match Feed Check completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "international",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Match Feed Check updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "away-team",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Match Feed Check updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "settlementSummary",
          "valueTemplate": "Scheduled Match Feed Check completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "match-data-reader",
        "settlement-analyst",
        "team-morale",
        "sports-chronicle"
      ],
      "isActive": true
    }
  ],
  "manualActions": [
    {
      "id": "settle-match",
      "label": "Settle Match",
      "description": "Settle the prepared match result.",
      "triggerId": "manual-match-settlement",
      "ownerOnly": true
    },
    {
      "id": "review-dispute",
      "label": "Review Dispute",
