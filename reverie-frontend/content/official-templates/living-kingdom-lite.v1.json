{
  "uiSlug": "living-kingdom-lite",
  "displayName": "Living Kingdom Lite",
  "description": "A fantasy world template where weather, market-like pressure, and player actions update territories, faction morale, conflicts, and Chronicle history.",
  "version": "living-kingdom-lite-v1",
  "engine": "genericEventWorld",
  "publicTypes": {
    "KingdomClimate": [
      "CALM",
      "STORMY",
      "PROSPEROUS",
      "TENSE",
      "WAR"
    ],
    "inputs": [
      "focusZoneId",
      "playerAction",
      "weatherCity"
    ]
  },
  "inputSchema": [
    {
      "id": "focusZoneId",
      "label": "Focus zone",
      "type": "select",
      "required": true,
      "defaultValue": "northern-reaches",
      "options": [
        {
          "label": "Northern Reaches",
          "value": "northern-reaches"
        },
        {
          "label": "Merchant Quarter",
          "value": "merchant-quarter"
        },
        {
          "label": "Ancient Forest",
          "value": "ancient-forest"
        },
        {
          "label": "Disputed Borderlands",
          "value": "disputed-borderlands"
        },
        {
          "label": "Neutral City",
          "value": "neutral-city"
        }
      ]
    },
    {
      "id": "weatherCity",
      "label": "Weather city",
      "type": "text",
      "required": true,
      "defaultValue": "London"
    },
    {
      "id": "playerAction",
      "label": "Player action",
      "type": "text",
      "required": true,
      "defaultValue": "Fortify the Northern Reaches before the storm reaches the mountain pass."
    }
  ],
  "dataSources": [
    {
      "id": "londonWeather",
      "name": "London Weather JSON",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=51.5072&longitude=-0.1276&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    },
    {
      "id": "marketMood",
      "name": "Market Mood JSON",
      "type": "json",
      "url": "https://api.binance.com/api/v3/ticker/24hr?symbol=ETHUSDT",
      "method": "GET"
    }
  ],
  "agentChain": [
    {
      "id": "world-feed-reader",
      "name": "World Feed Reader",
      "agentType": "native_json_api",
      "purpose": "Read weather and market-flavored data for the fantasy world tick.",
      "inputTemplate": "Inspect world feed for {{runtime.inputs.focusZoneId}} from {{source.value}}.",
      "persistResult": false
    },
    {
      "id": "kingdom-event-synthesizer",
      "name": "Kingdom Event Synthesizer",
      "agentType": "native_llm",
      "purpose": "Turn real-world signals or player input into a fantasy event JSON.",
      "inputTemplate": "Create a kingdom event for {{runtime.inputs.focusZoneId}} using {{runtime.inputs.playerAction}} and {{previous.output}}.",
      "persistResult": false
    },
    {
      "id": "territory-climate",
      "name": "Territory Climate Agent",
      "agentType": "reverie_custom",
      "purpose": "Update territory climate and pressure state.",
      "inputTemplate": "Update territory state for {{runtime.inputs.focusZoneId}} from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "faction-morale",
      "name": "Faction Morale Agent",
      "agentType": "native_llm",
      "purpose": "Recalculate faction morale from the latest event.",
      "inputTemplate": "Update faction morale for Ironforge, Trade Alliance, Verdant Circle, and Order of Dawn from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "border-conflict",
      "name": "Border Conflict Resolver",
      "agentType": "reverie_custom",
      "purpose": "Resolve control or alliance changes when factions clash.",
      "inputTemplate": "Resolve any border conflict or alliance implication from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "kingdom-chronicle",
      "name": "Kingdom Chronicle Agent",
      "agentType": "reverie_custom",
      "purpose": "Write a verifiable fantasy history entry.",
      "inputTemplate": "Write an epic but concise Chronicle entry for {{previous.output}}.",
      "persistResult": true
    }
  ],
  "zones": [
    {
      "id": "northern-reaches",
      "name": "The Northern Reaches",
      "description": "Weather-driven mountain region.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 20,
        "controllingFaction": "ironforge-clan",
        "climate": "CALM"
      },
      "allocationPercent": 20
    },
    {
      "id": "merchant-quarter",
      "name": "The Merchant Quarter",
      "description": "Trade hub affected by market pressure.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 20,
        "controllingFaction": "trade-alliance",
        "climate": "CALM"
      },
      "allocationPercent": 20
    },
    {
      "id": "ancient-forest",
      "name": "The Ancient Forest",
      "description": "Mystical zone affected by volatility and balance.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 20,
        "controllingFaction": "verdant-circle",
        "climate": "CALM"
      },
      "allocationPercent": 20
    },
    {
      "id": "disputed-borderlands",
      "name": "The Disputed Borderlands",
      "description": "Territory controlled by conflict outcomes.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 20,
        "controllingFaction": "order-of-dawn",
        "climate": "TENSE"
      },
      "allocationPercent": 20
    },
    {
      "id": "neutral-city",
      "name": "The Neutral City",
      "description": "Manual actions, alliances, and proposals.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 20,
        "controllingFaction": "ironforge-clan",
        "climate": "CALM"
      },
      "allocationPercent": 20
    }
  ],
  "factions": [
    {
      "id": "ironforge-clan",
      "name": "Ironforge Clan",
      "description": "Warriors strengthened by harsh weather.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Ironforge Clan is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "trade-alliance",
      "name": "Trade Alliance",
      "description": "Merchants driven by market conditions.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Trade Alliance is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "verdant-circle",
      "name": "Verdant Circle",
      "description": "Mystics affected by volatility and balance.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Verdant Circle is initialized from the template manifest."
      },
      "allocationPercent": 25
    },
    {
      "id": "order-of-dawn",
      "name": "Order of Dawn",
      "description": "Paladins strengthened by heroic Chronicle sentiment.",
      "state": {
        "latestDecision": "pending",
        "morale": 25,
        "narrative": "Order of Dawn is initialized from the template manifest."
      },
      "allocationPercent": 25
    }
  ],
  "triggers": [
    {
      "id": "start-kingdom-runtime",
      "name": "Start Kingdom Runtime",
      "type": "data_condition",
      "sourceId": "londonWeather",
      "condition": {
        "isStartTrigger": true
      },
      "sourceConfig": {
        "kind": "builder_input",
        "sourceId": "focusZoneId",
        "path": ""
      },
      "typeConfig": {
        "conditionEnabled": false,
        "operator": "exists",
        "compareValue": ""
      },
      "inputParser": "{\n  \"focusZoneId\": \"{{runtime.inputs.focusZoneId}}\",\n  \"weatherCity\": \"{{runtime.inputs.weatherCity}}\",\n  \"playerAction\": \"{{runtime.inputs.playerAction}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Kingdom event log",
          "path": "eventLog",
          "valueTemplate": "Start Kingdom Runtime completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "northern-reaches",
          "path": "latestDecision",
          "valueTemplate": "Start Kingdom Runtime updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "ironforge-clan",
          "path": "latestDecision",
          "valueTemplate": "Start Kingdom Runtime updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "kingdomLatestTurn",
          "valueTemplate": "Start Kingdom Runtime completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "world-feed-reader",
        "kingdom-event-synthesizer",
        "territory-climate",
        "faction-morale",
        "border-conflict",
        "kingdom-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "manual-player-action",
      "name": "Manual Player Action",
      "type": "manual_action",
      "sourceId": "londonWeather",
      "sourceConfig": {
        "kind": "manual_payload",
        "path": ""
      },
      "typeConfig": {
        "buttonLabel": "Run Player Action",
        "description": "Apply a manual player action to the kingdom.",
        "payloadTemplate": "{\n  \"action\": \"{{runtime.inputs.playerAction}}\",\n  \"zone\": \"{{runtime.inputs.focusZoneId}}\"\n}"
      },
      "inputParser": "{\n  \"action\": \"{{runtime.inputs.playerAction}}\",\n  \"payload\": \"{{trigger.payload}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Kingdom event log",
          "path": "eventLog",
          "valueTemplate": "Manual Player Action completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "merchant-quarter",
          "path": "latestDecision",
          "valueTemplate": "Manual Player Action updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "order-of-dawn",
          "path": "latestDecision",
          "valueTemplate": "Manual Player Action updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "kingdomLatestTurn",
          "valueTemplate": "Manual Player Action completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "kingdom-event-synthesizer",
        "territory-climate",
        "faction-morale",
        "border-conflict",
        "kingdom-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "scheduled-kingdom-tick",
      "name": "Scheduled Kingdom Tick",
      "type": "scheduled",
      "sourceId": "londonWeather",
      "sourceConfig": {
        "kind": "data_source",
        "sourceId": "londonWeather",
        "path": "body.current"
      },
      "typeConfig": {
        "cronExpression": "0 * * * *",
        "timezone": "UTC"
      },
      "inputParser": "{\n  \"focusZoneId\": \"{{runtime.inputs.focusZoneId}}\",\n  \"weather\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Kingdom event log",
          "path": "eventLog",
          "valueTemplate": "Scheduled Kingdom Tick completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "ancient-forest",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Kingdom Tick updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "verdant-circle",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Kingdom Tick updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "kingdomLatestTurn",
          "valueTemplate": "Scheduled Kingdom Tick completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "world-feed-reader",
        "kingdom-event-synthesizer",
        "territory-climate",
        "faction-morale",
        "kingdom-chronicle"
      ],
      "isActive": true
    }
  ],
  "manualActions": [
    {
      "id": "run-player-action",
      "label": "Run Player Action",
      "description": "Run the configured player action.",
      "triggerId": "manual-player-action",
      "ownerOnly": true
    }
  ],
