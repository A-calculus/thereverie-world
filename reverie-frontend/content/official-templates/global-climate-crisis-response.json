{
  "uiSlug": "global-climate-crisis-response",
  "displayName": "Global Climate Crisis Response",
  "description": "Autonomous crisis-response world that checks fixed public weather feeds, classifies regional severity, updates response zones and agency factions, and records receipt-backed crisis movement.",
  "version": "climate-crisis-response-v2",
  "engine": "genericEventWorld",
  "publicTypes": {
    "ClimateSeverity": [
      "STABLE",
      "WATCH",
      "WARNING",
      "EMERGENCY"
    ],
    "ResponseDecision": [
      "monitor",
      "mobilize",
      "escalate",
      "stand_down"
    ],
    "inputs": [
      "regionId",
      "severityThreshold",
      "drillScenario"
    ]
  },
  "inputSchema": [
    {
      "id": "regionId",
      "label": "Focus region",
      "type": "select",
      "required": true,
      "defaultValue": "europe",
      "options": [
        {
          "label": "Americas Zone",
          "value": "americas"
        },
        {
          "label": "Europe Zone",
          "value": "europe"
        },
        {
          "label": "Asia-Pacific Zone",
          "value": "asia-pacific"
        },
        {
          "label": "Africa / Middle East Zone",
          "value": "africa-middle-east"
        }
      ]
    },
    {
      "id": "severityThreshold",
      "label": "Severity threshold",
      "type": "number",
      "required": true,
      "defaultValue": 2
    },
    {
      "id": "drillScenario",
      "label": "Manual drill scenario",
      "type": "text",
      "required": true,
      "defaultValue": "Heavy rain and wind threaten transport corridors near London."
    }
  ],
  "dataSources": [
    {
      "id": "weatherAmericas",
      "name": "Americas Weather Feed",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=40.7128&longitude=-74.0060&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    },
    {
      "id": "weatherEurope",
      "name": "Europe Weather Feed",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=51.5072&longitude=-0.1276&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    },
    {
      "id": "weatherAsiaPacific",
      "name": "Asia-Pacific Weather Feed",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=35.6762&longitude=139.6503&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    },
    {
      "id": "weatherAfricaMiddleEast",
      "name": "Africa / Middle East Weather Feed",
      "type": "weather",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=25.2048&longitude=55.2708&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "method": "GET"
    }
  ],
  "agentChain": [
    {
      "id": "weather-reader-americas",
      "name": "Americas Weather Reader",
      "agentType": "native_json_api",
      "purpose": "Fetch current weather for the Americas response zone.",
      "inputTemplate": "Read current Americas weather. Return only the selected current object.",
      "urlTemplate": "https://api.open-meteo.com/v1/forecast?latitude=40.7128&longitude=-74.0060&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "selector": "current",
      "resultAlias": "americasWeather",
      "persistResult": true
    },
    {
      "id": "weather-reader-europe",
      "name": "Europe Weather Reader",
      "agentType": "native_json_api",
      "purpose": "Fetch current weather for the Europe response zone.",
      "inputTemplate": "Read current Europe weather. Return only the selected current object.",
      "urlTemplate": "https://api.open-meteo.com/v1/forecast?latitude=51.5072&longitude=-0.1276&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "selector": "current",
      "resultAlias": "europeWeather",
      "persistResult": true
    },
    {
      "id": "weather-reader-asia-pacific",
      "name": "Asia-Pacific Weather Reader",
      "agentType": "native_json_api",
      "purpose": "Fetch current weather for the Asia-Pacific response zone.",
      "inputTemplate": "Read current Asia-Pacific weather. Return only the selected current object.",
      "urlTemplate": "https://api.open-meteo.com/v1/forecast?latitude=35.6762&longitude=139.6503&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "selector": "current",
      "resultAlias": "asiaPacificWeather",
      "persistResult": true
    },
    {
      "id": "weather-reader-africa-middle-east",
      "name": "Africa / Middle East Weather Reader",
      "agentType": "native_json_api",
      "purpose": "Fetch current weather for the Africa / Middle East response zone.",
      "inputTemplate": "Read current Africa / Middle East weather. Return only the selected current object.",
      "urlTemplate": "https://api.open-meteo.com/v1/forecast?latitude=25.2048&longitude=55.2708&current=temperature_2m,wind_speed_10m,precipitation,weather_code",
      "selector": "current",
      "resultAlias": "africaMiddleEastWeather",
      "persistResult": true
    },
    {
      "id": "severity-assessor",
      "name": "Severity Assessment Agent",
      "agentType": "native_llm",
      "purpose": "Classify crisis severity for all regional feeds and recommend response posture.",
      "inputTemplate": "Task: classify the latest crisis severity for Americas, Europe, Asia-Pacific, and Africa / Middle East. Use the fixed weather feeds, threshold, trigger payload, and previous weather-reader outputs. Return compact JSON only with severityByRegion, focusRegion, latestSeverity, decision, confidence, summary, and nextAction.",
      "contextTemplate": "Runtime inputs: {{runtime.inputs}}\nTrigger payload: {{trigger.payload}}\nAmericas feed: {{dataSources.weatherAmericas.body.current}}\nEurope feed: {{dataSources.weatherEurope.body.current}}\nAsia-Pacific feed: {{dataSources.weatherAsiaPacific.body.current}}\nAfrica / Middle East feed: {{dataSources.weatherAfricaMiddleEast.body.current}}\nPrevious step result: {{previous.output}}",
      "systemPrompt": "You are the REVERIE Climate Severity Agent. Return only compact valid JSON with no markdown.",
      "resultAlias": "severityAssessment",
      "persistResult": true
    },
    {
      "id": "zone-climate-update",
      "name": "Zone Climate Agent",
      "agentType": "reverie_custom",
      "purpose": "Convert severity assessment into visible zone-state movement.",
      "inputTemplate": "Task: produce concise zone state updates from the severity assessment. Return compact JSON only with zoneUpdates keyed by americas, europe, asia-pacific, africa-middle-east; each value has climate, dangerLevel, latestDecision, and narrative.",
      "contextTemplate": "Runtime inputs: {{runtime.inputs}}\nSeverity assessment: {{previous.output}}\nWeather feeds: {\"americas\":{{dataSources.weatherAmericas.body.current}},\"europe\":{{dataSources.weatherEurope.body.current}},\"asiaPacific\":{{dataSources.weatherAsiaPacific.body.current}},\"africaMiddleEast\":{{dataSources.weatherAfricaMiddleEast.body.current}}}",
      "systemPrompt": "You are the REVERIE Zone Climate Agent. Return only compact valid JSON with no markdown.",
      "resultAlias": "zoneClimateUpdates",
      "persistResult": true
    },
    {
      "id": "agency-readiness",
      "name": "Agency Readiness Agent",
      "agentType": "native_llm",
      "purpose": "Update response agency morale and readiness posture.",
      "inputTemplate": "Task: map the zone climate updates into agency readiness. Return compact JSON only with factionUpdates for government, ngo, private-sector, and insurance; each value has morale, latestDecision, and narrative.",
      "contextTemplate": "Runtime inputs: {{runtime.inputs}}\nZone climate updates: {{previous.output}}\nSeverity threshold: {{runtime.inputs.severityThreshold}}",
      "systemPrompt": "You are the REVERIE Agency Readiness Agent. Return only compact valid JSON with no markdown.",
      "resultAlias": "agencyReadiness",
      "persistResult": true
    },
    {
      "id": "crisis-decision-router",
      "name": "Crisis Decision Router",
      "agentType": "native_llm",
      "purpose": "Choose the autonomous continuation path from severity, zone, and agency readiness evidence.",
      "inputTemplate": "Task: choose the next autonomous crisis response route. Return compact JSON only and make the first key decision. Allowed decision values are monitor, mobilize, escalate, stand_down. Use mobilize/escalate for WARNING or EMERGENCY posture, monitor for WATCH, and stand_down for STABLE.",
      "contextTemplate": "Runtime inputs: {{runtime.inputs}}\nAgency readiness: {{previous.output}}\nSeverity assessment and feeds were provided by previous workflow steps.\nReturn exactly this JSON shape: {\"decision\":\"monitor|mobilize|escalate|stand_down\",\"latestSeverity\":\"STABLE|WATCH|WARNING|EMERGENCY\",\"focusRegion\":\"{{runtime.inputs.regionId}}\",\"summary\":\"...\",\"stateEffects\":{\"world\":\"...\",\"zones\":\"...\",\"factions\":\"...\"},\"nextAction\":\"continue|record|stop\"}",
      "systemPrompt": "You are the REVERIE Climate Decision Router. Return only compact valid JSON with decision as the first key. No markdown.",
      "resultAlias": "crisisDecision",
      "persistResult": true
    }
  ],
  "zones": [
