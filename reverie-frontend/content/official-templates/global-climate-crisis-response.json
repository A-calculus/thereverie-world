      "typeConfig": {
        "cronExpression": "*/30 * * * *",
        "timezone": "UTC",
        "payloadTemplate": "{\n  \"mode\": \"scheduled_weather_scan\",\n  \"startedAt\": \"{{source.value}}\",\n  \"focusRegion\": \"{{runtime.inputs.regionId}}\",\n  \"severityThreshold\": \"{{runtime.inputs.severityThreshold}}\",\n  \"feeds\": {\n    \"americas\": {{dataSources.weatherAmericas.body.current}},\n    \"europe\": {{dataSources.weatherEurope.body.current}},\n    \"asiaPacific\": {{dataSources.weatherAsiaPacific.body.current}},\n    \"africaMiddleEast\": {{dataSources.weatherAfricaMiddleEast.body.current}}\n  }\n}"
