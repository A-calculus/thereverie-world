{
  "uiSlug": "crypto-market-intelligence",
  "displayName": "Crypto Market Intelligence Arena",
  "description": "A verifiable market-signal world that reads public token data, updates market zones and strategy factions, and records every signal as a Chronicle-backed recommendation.",
  "version": "crypto-market-intelligence-v1",
  "engine": "genericEventWorld",
  "publicTypes": {
    "MarketSignal": [
      "BULLISH",
      "BEARISH",
      "NEUTRAL",
      "VOLATILE"
    ],
    "inputs": [
      "marketPair",
      "volatilityThreshold",
      "shockScenario"
    ]
  },
  "inputSchema": [
    {
      "id": "marketPair",
      "label": "Market pair",
      "type": "select",
      "required": true,
      "defaultValue": "BTCUSDT",
      "options": [
        {
          "label": "BTC / USDT",
          "value": "BTCUSDT"
        },
        {
          "label": "ETH / USDT",
          "value": "ETHUSDT"
        },
        {
          "label": "SOL / USDT",
          "value": "SOLUSDT"
        }
      ]
    },
    {
      "id": "volatilityThreshold",
      "label": "Volatility threshold (%)",
      "type": "number",
      "required": true,
      "defaultValue": 3
    },
    {
      "id": "shockScenario",
      "label": "Manual shock scenario",
      "type": "text",
      "required": true,
      "defaultValue": "BTC drops 4.5% while volume spikes and funding turns defensive."
    }
  ],
  "dataSources": [
    {
      "id": "binanceTicker",
      "name": "Public Token Price JSON",
      "type": "json",
      "url": "https://api.binance.com/api/v3/ticker/24hr?symbol={{runtime.inputs.marketPair}}",
      "method": "GET"
    }
  ],
  "agentChain": [
    {
      "id": "market-data-reader",
      "name": "Market Data Reader",
      "agentType": "native_json_api",
      "purpose": "Read public token price, volume, and 24-hour change values.",
      "inputTemplate": "Inspect public market data for {{runtime.inputs.marketPair}} from {{source.value}}.",
      "persistResult": false
    },
    {
      "id": "market-risk-analyst",
      "name": "Market Risk Analyst",
      "agentType": "native_llm",
      "purpose": "Classify market climate and recommend HOLD, REDUCE, ACCUMULATE, or WATCH.",
      "inputTemplate": "Assess {{runtime.inputs.marketPair}} with threshold {{runtime.inputs.volatilityThreshold}} and previous output {{previous.output}}.",
      "persistResult": false
    },
    {
      "id": "strategy-morale",
      "name": "Strategy Morale Agent",
      "agentType": "native_llm",
      "purpose": "Update Bull, Bear, and Hedge faction confidence.",
      "inputTemplate": "Map the market signal into Bull, Bear, and Hedge confidence deltas using {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "market-conflict",
      "name": "Market Conflict Resolver",
      "agentType": "reverie_custom",
      "purpose": "Resolve disagreement between strategy factions into one recommendation.",
      "inputTemplate": "Resolve the strategy disagreement from {{previous.output}}.",
      "persistResult": true
    },
    {
      "id": "market-chronicle",
      "name": "Market Chronicle Agent",
      "agentType": "reverie_custom",
      "purpose": "Write the market briefing and receipt-backed recommendation.",
      "inputTemplate": "Write a concise market Chronicle entry for {{previous.output}}.",
      "persistResult": true
    }
  ],
  "zones": [
    {
      "id": "layer-one-assets",
      "name": "Layer-1 Assets Zone",
      "description": "BTC, ETH, SOL, and core settlement assets.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "bull-faction",
        "climate": "NEUTRAL",
        "marketClimate": "NEUTRAL"
      },
      "allocationPercent": 25
    },
    {
      "id": "defi-protocols",
      "name": "DeFi Protocols Zone",
      "description": "DEX, lending, and yield protocol risk.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "bear-faction",
        "climate": "NEUTRAL",
        "marketClimate": "NEUTRAL"
      },
      "allocationPercent": 25
    },
    {
      "id": "meme-emerging",
      "name": "Meme / Emerging Zone",
      "description": "High volatility and new-launch token behavior.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "hedge-faction",
        "climate": "NEUTRAL",
        "marketClimate": "NEUTRAL"
      },
      "allocationPercent": 25
    },
    {
      "id": "stablecoin-yield",
      "name": "Stablecoin / Yield Zone",
      "description": "Lower-volatility and defensive market instruments.",
      "state": {
        "latestDecision": "pending",
        "dangerLevel": 25,
        "controllingFaction": "bull-faction",
        "climate": "NEUTRAL",
        "marketClimate": "NEUTRAL"
      },
      "allocationPercent": 25
    }
  ],
  "factions": [
    {
      "id": "bull-faction",
      "name": "Bull Faction",
      "description": "Momentum strategy seeking risk-on opportunities.",
      "state": {
        "latestDecision": "pending",
        "morale": 34,
        "narrative": "Bull Faction is initialized from the template manifest."
      },
      "allocationPercent": 34
    },
    {
      "id": "bear-faction",
      "name": "Bear Faction",
      "description": "Defensive strategy seeking capital preservation.",
      "state": {
        "latestDecision": "pending",
        "morale": 33,
        "narrative": "Bear Faction is initialized from the template manifest."
      },
      "allocationPercent": 33
    },
    {
      "id": "hedge-faction",
      "name": "Neutral / Hedge Faction",
      "description": "Volatility-managed strategy balancing both sides.",
      "state": {
        "latestDecision": "pending",
        "morale": 33,
        "narrative": "Neutral / Hedge Faction is initialized from the template manifest."
      },
      "allocationPercent": 33
    }
  ],
  "triggers": [
    {
      "id": "start-market-runtime",
      "name": "Start Market Intelligence Runtime",
      "type": "data_condition",
      "sourceId": "binanceTicker",
      "condition": {
        "isStartTrigger": true
      },
      "sourceConfig": {
        "kind": "builder_input",
        "sourceId": "marketPair",
        "path": ""
      },
      "typeConfig": {
        "conditionEnabled": false,
        "operator": "exists",
        "compareValue": ""
      },
      "inputParser": "{\n  \"marketPair\": \"{{runtime.inputs.marketPair}}\",\n  \"volatilityThreshold\": \"{{runtime.inputs.volatilityThreshold}}\",\n  \"source\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Market event log",
          "path": "eventLog",
          "valueTemplate": "Start Market Intelligence Runtime completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "layer-one-assets",
          "path": "latestDecision",
          "valueTemplate": "Start Market Intelligence Runtime updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "hedge-faction",
          "path": "latestDecision",
          "valueTemplate": "Start Market Intelligence Runtime updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "marketSignalSummary",
          "valueTemplate": "Start Market Intelligence Runtime completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "market-data-reader",
        "market-risk-analyst",
        "strategy-morale",
        "market-conflict",
        "market-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "manual-market-shock",
      "name": "Manual Market Shock Analysis",
      "type": "manual_action",
      "sourceId": "binanceTicker",
      "sourceConfig": {
        "kind": "manual_payload",
        "path": ""
      },
      "typeConfig": {
        "buttonLabel": "Run Market Shock",
        "description": "Analyze a prepared market shock and write a recommendation.",
        "payloadTemplate": "{\n  \"scenario\": \"{{runtime.inputs.shockScenario}}\",\n  \"marketPair\": \"{{runtime.inputs.marketPair}}\"\n}"
      },
      "inputParser": "{\n  \"scenario\": \"{{runtime.inputs.shockScenario}}\",\n  \"payload\": \"{{trigger.payload}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Market event log",
          "path": "eventLog",
          "valueTemplate": "Manual Market Shock Analysis completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "defi-protocols",
          "path": "latestDecision",
          "valueTemplate": "Manual Market Shock Analysis updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "bear-faction",
          "path": "latestDecision",
          "valueTemplate": "Manual Market Shock Analysis updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "marketSignalSummary",
          "valueTemplate": "Manual Market Shock Analysis completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "market-risk-analyst",
        "strategy-morale",
        "market-conflict",
        "market-chronicle"
      ],
      "isActive": true
    },
    {
      "id": "scheduled-market-scan",
      "name": "Scheduled Market Scan",
      "type": "scheduled",
      "sourceId": "binanceTicker",
      "sourceConfig": {
        "kind": "data_source",
        "sourceId": "binanceTicker",
        "path": "body"
      },
      "typeConfig": {
        "cronExpression": "*/15 * * * *",
        "timezone": "UTC"
      },
      "inputParser": "{\n  \"marketPair\": \"{{runtime.inputs.marketPair}}\",\n  \"ticker\": \"{{source.value}}\"\n}",
      "outputMapping": [
        {
          "target": "event",
          "targetId": "Market event log",
          "path": "eventLog",
          "valueTemplate": "Scheduled Market Scan completed and wrote an event log.",
          "weightPercent": 10
        },
        {
          "target": "zone",
          "targetId": "meme-emerging",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Market Scan updated the selected zone state.",
          "weightPercent": 30
        },
        {
          "target": "faction",
          "targetId": "bull-faction",
          "path": "latestDecision",
          "valueTemplate": "Scheduled Market Scan updated the faction state.",
          "weightPercent": 30
        },
        {
          "target": "world_state",
          "path": "marketSignalSummary",
          "valueTemplate": "Scheduled Market Scan completed and refreshed the world summary.",
          "weightPercent": 30
        }
      ],
      "agentChain": [
        "market-data-reader",
        "market-risk-analyst",
        "strategy-morale",
        "market-chronicle"
      ],
      "isActive": true
    }
  ],
  "manualActions": [
    {
      "id": "run-market-shock",
      "label": "Run Market Shock",
      "description": "Run the configured market shock scenario.",
      "triggerId": "manual-market-shock",
