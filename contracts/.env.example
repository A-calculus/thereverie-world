# Deployer wallet — Hardhat deploy ONLY (Timelock + proxy system)
# Copy to contracts/.env. Do NOT use this key in the browser SDK.
#
#   npm run deploy:testnet
#   npm run update:testnet                       # timelock worldConfig update
#   npm run set-world-implementation:testnet     # timelock future-world implementation update
#   npm run upgrade:registry:testnet             # timelock UUPS registry proxy upgrade
#   npm run upgrade:callback:testnet             # timelock UUPS callback proxy upgrade

DEPLOYER_PRIVATE_KEY=

# Legacy alias (deploy script accepts either name)
PRIVATE_KEY=

SOMNIA_RPC_URL=

# Optional testnet agent config. These names match the SDK defaults.
SOMNIA_PLATFORM_LLM=
SOMNIA_PLATFORM_PRIMARY=
SOMNIA_AGENT_ID_LLM=
SOMNIA_AGENT_ID_JSON_API=
SOMNIA_AGENT_ID_WEB_PARSE=
DEFAULT_SUBCOMMITTEE_SIZE=
DEFAULT_CONSENSUS_TYPE=
DEFAULT_THRESHOLD=
DEFAULT_REQUEST_TIMEOUT=

UPGRADE_DELAY_SECONDS=
UPGRADE_PROPOSER_ADDRESS=
UPGRADE_EXECUTOR_ADDRESS=
TIMELOCK_ACTION=
TIMELOCK_SALT=

TIMELOCK_ADDRESS=
REGISTRY_IMPLEMENTATION_ADDRESS=
WORLD_IMPLEMENTATION_ADDRESS=
NEW_WORLD_IMPLEMENTATION_ADDRESS=
NEW_REGISTRY_IMPLEMENTATION_ADDRESS=
NEW_CALLBACK_IMPLEMENTATION_ADDRESS=
CALLBACK_RECEIVER_IMPLEMENTATION=
CALLBACK_RECEIVER_LLM=
CALLBACK_RECEIVER_PRIMARY=
REVERIE_REGISTRY_ADDRESS=
CALLBACK_TARGET=   #llm or primary
CALLBACK_PROXY_ADDRESS=
TIMELOCK_TX_HASH=

# After deploy, copy logged addresses into sdk/.env (builder / runtime config).
# Timelocked scripts require TIMELOCK_ADDRESS plus the relevant proxy address.
#
# Console output now uses the same KEY=value names as this file.
# deploy:testnet prints:
#   UPGRADE_DELAY_SECONDS
#   UPGRADE_PROPOSER_ADDRESS
#   UPGRADE_EXECUTOR_ADDRESS
#   TIMELOCK_ADDRESS
#   REGISTRY_IMPLEMENTATION_ADDRESS
#   REVERIE_REGISTRY_ADDRESS
#   WORLD_IMPLEMENTATION_ADDRESS
#   CALLBACK_RECEIVER_IMPLEMENTATION
#   CALLBACK_RECEIVER_LLM
#   CALLBACK_RECEIVER_PRIMARY
#
# update:testnet prints:
#   TIMELOCK_ACTION
#   TIMELOCK_ADDRESS
#   REVERIE_REGISTRY_ADDRESS
#   UPGRADE_DELAY_SECONDS
#   TIMELOCK_TX_HASH
#   TIMELOCK_SALT
#   plus the worldConfig env keys above.
#
# set-world-implementation:testnet prints:
#   TIMELOCK_ACTION
#   TIMELOCK_ADDRESS
#   REVERIE_REGISTRY_ADDRESS
#   UPGRADE_DELAY_SECONDS
#   NEW_WORLD_IMPLEMENTATION_ADDRESS
#   TIMELOCK_TX_HASH
#   TIMELOCK_SALT
#
# upgrade:registry:testnet prints:
#   TIMELOCK_ACTION
#   TIMELOCK_ADDRESS
#   REVERIE_REGISTRY_ADDRESS
#   UPGRADE_DELAY_SECONDS
#   NEW_REGISTRY_IMPLEMENTATION_ADDRESS
#   TIMELOCK_TX_HASH
#   TIMELOCK_SALT
#
# upgrade:callback:testnet prints:
#   TIMELOCK_ACTION
#   TIMELOCK_ADDRESS
#   CALLBACK_TARGET
#   CALLBACK_PROXY_ADDRESS
#   UPGRADE_DELAY_SECONDS
#   NEW_CALLBACK_IMPLEMENTATION_ADDRESS
#   TIMELOCK_TX_HASH
#   TIMELOCK_SALT
