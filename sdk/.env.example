# Builder wallet — WorldFrame SDK (deployWorld, agents, triggers, STT deposits)
# Use BUILDER_PRIVATE_KEY in Node, or browser mode with MetaMask (no key in .env).

SOMNIA_NETWORK=

# Builder / world owner (NOT the contracts deployer key)
BUILDER_PRIVATE_KEY=
# Legacy alias
PRIVATE_KEY=

# Post-deploy (from contracts deploy script output)
CALLBACK_RECEIVER_LLM=
CALLBACK_RECEIVER_PRIMARY=
REVERIE_REGISTRY_ADDRESS=

# Agentkit defaults (optional — documented fallbacks in addresses.ts)
DEFAULT_SUBCOMMITTEE_SIZE=
DEFAULT_CONSENSUS_TYPE=
DEFAULT_THRESHOLD=
# Wei value. 0.09 STT = 90000000000000000 wei.
DEFAULT_DEPOSIT_BUFFER=
CONFIDENCE_THRESHOLD_DEFAULT=
